      <tr data-coverage="{{coverage_data}}">
       <th scope="row" class="name" data-metric="lines-name" data-level="{{lines_level}}">{{name}}</th>
       <td class="bar-cell" data-metric="lines-bar" data-level="{{lines_level}}">{{lines_bar}}</td>
       <td class="percentage" data-metric="lines-percent" data-level="{{lines_level}}">{{lines_executed_percent}}</td>
       <td class="count" data-metric="lines-number" data-level="{{lines_level}}">{{lines_number}}</td>
       <td class="bar-cell" data-metric="branches-bar" data-level="{{branches_level}}">{{branches_bar}}</td>
       <td class="percentage" data-metric="branches-percent" data-level="{{branches_level}}">{{branches_executed_percent}}</td>
       <td class="count" data-metric="branches-number" data-level="{{branches_level}}">{{branches_number}}</td>
       <td class="bar-cell" data-metric="methods-bar" data-level="{{methods_level}}">{{methods_bar}}</td>
       <td class="percentage" data-metric="methods-percent" data-level="{{methods_level}}">{{methods_tested_percent}}</td>
       <td class="count" data-metric="methods-number" data-level="{{methods_level}}">{{methods_number}}</td>
       <td class="crap" data-level="{{methods_level}}">{{crap}}</td>
       <td class="bar-cell" data-metric="classes-bar" data-level="{{classes_level}}">{{classes_bar}}</td>
       <td class="percentage" data-metric="classes-percent" data-level="{{classes_level}}">{{classes_tested_percent}}</td>
       <td class="count" data-metric="classes-number" data-level="{{classes_level}}">{{classes_number}}</td>
      </tr>
